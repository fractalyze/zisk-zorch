# bazel 9 defaults to bzlmod (WORKSPACE is gone), so no enable flags needed.
build --announce_rc
test --test_output=errors

# Every package commits its __init__.py, so rules_python's legacy auto-init
# has nothing to add — and it is actively harmful: for a py_test whose dep
# closure carries no committed init (a leaf library), the auto-created empty
# __init__.py can land through a runfiles symlink and TRUNCATE the source
# file in the working tree (observed on bazel 9.1.0: zisk_zorch/__init__.py
# zeroed, taking __version__ with it — the string pyproject.toml and
# release.yml derive the package version from).
build --incompatible_default_to_explicit_init_py

# Tests are backend-agnostic; CPU is the default (not a requirement) so plain
# `bazel test` is deterministic on any machine. CI overrides it per matrix leg
# via --test_env (the GPU leg pins FRX_PLATFORMS=cuda).
test --test_env=FRX_PLATFORMS=cpu

# `gpu`-tagged targets assert something only the card can answer (that the
# pinned plugin turned each hash marker into a custom fusion), so they fail
# under the CPU default a plain `bazel test //...` runs on. Filtered out here;
# CI's GPU leg clears the filter with `--test_tag_filters=` on the command
# line (which wins over this file), and so does a local GPU run.
test --test_tag_filters=-gpu

# Local, machine-specific overrides (gitignored). For dev against a local zorch
# working copy instead of the pinned git_override, add to .bazelrc.user:
#   common --override_module=zorch=/abs/path/to/your/zorch/checkout
try-import %workspace%/.bazelrc.user
