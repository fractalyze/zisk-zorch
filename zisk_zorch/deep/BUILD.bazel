load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")
load("@zisk_zorch_pip//:requirements.bzl", "requirement")

# pil2's calculateFRIPolynomial: threads the transcript and supplies pil2's coset,
# root, and LEv to zorch.pcs.deep's scheme-neutral batched quotient + evmap.
py_library(
    name = "fri_polynomial",
    srcs = [
        "__init__.py",
        "fri_polynomial.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//zisk_zorch/evals:lev",
        "//zisk_zorch/fri:seam",
        "//zisk_zorch/quotient",
        requirement("frx"),
        requirement("pyzorch"),
    ],
)

py_test(
    name = "fri_polynomial_test",
    size = "small",
    srcs = ["fri_polynomial_test.py"],
    deps = [
        ":fri_polynomial",
        "//zisk_zorch/fri:fold",
        "//zisk_zorch/fri:seam",
        "//zisk_zorch/quotient",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
        requirement("pyzorch"),
    ],
)

# pil2 evmap integration: pil2's LEv (`//zisk_zorch/evals:lev`) feeding
# zorch.pcs.deep.open_columns, pinned by the barycentric round trip.
py_test(
    name = "opening_test",
    size = "small",
    srcs = ["opening_test.py"],
    deps = [
        "//zisk_zorch/evals:lev",
        "//zisk_zorch/quotient",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
        requirement("pyzorch"),
    ],
)

# DEEP-codeword byte-match runnable vs a pil2 computeFRIExpression dump
# (--dump=<dir>). Runs the PRODUCTION blocked primitive, so it needs a
# pyzorch wheel carrying zorch#541's deep_numerator_block — the pinned
# dev20260722235316 predates it. Add the fixture py_test with the pin bump.
py_binary(
    name = "verify_fri_polynomial",
    srcs = ["verify_fri_polynomial.py"],
    deps = [
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
        requirement("pyzorch"),
    ],
)
