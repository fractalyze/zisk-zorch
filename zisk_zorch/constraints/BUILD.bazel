load("@rules_python//python:defs.bzl", "py_library", "py_test")
load("@zisk_zorch_pip//:requirements.bzl", "requirement")

# Stage-2 constraint/interaction ingestion: load riscv-witness's ZisK export
# (constraints/zisk/v1) via rw_constraints with the Goldilocks field bound.
py_library(
    name = "chip_loader",
    srcs = [
        "__init__.py",
        "chip_loader.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        requirement("rw_constraints"),
        requirement("zk_dtypes"),
    ],
)

# The proving key's preprocessed (fixed) columns — the trace flagged
# `is_preprocessed` interaction terms are evaluated against.
py_library(
    name = "preprocessed",
    srcs = [
        "__init__.py",
        "preprocessed.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ],
)

# Builds the `.const` payload the reader parses, so no blob is committed.
py_library(
    name = "const_fixture",
    srcs = ["const_fixture.py"],
    visibility = ["//visibility:public"],
    deps = [requirement("numpy")],
)

py_test(
    name = "preprocessed_test",
    size = "small",
    srcs = ["preprocessed_test.py"],
    deps = [
        ":const_fixture",
        ":preprocessed",
        # `eval_pair_col`, which this module supplies the prep trace for.
        "//zisk_zorch/logup",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
        # `PreprocessedColumn` — the manifest descriptor the join consumes.
        requirement("rw_constraints"),
    ],
)

py_test(
    name = "chip_loader_test",
    size = "medium",
    srcs = ["chip_loader_test.py"],
    deps = [
        ":chip_loader",
        # ZISK_CHIP_AIRS, which must cover the loaded chip set.
        ":preprocessed",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
        # `PreprocessedColumn` — the declared CLK_0 descriptors.
        requirement("rw_constraints"),
    ],
)
