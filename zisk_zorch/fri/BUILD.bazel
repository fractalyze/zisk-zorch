load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")
load("@zisk_zorch_pip//:requirements.bzl", "requirement")

# pil2's FRI fold: coset Lagrange interpolation evaluated at the cubic challenge.
py_library(
    name = "fold",
    srcs = [
        "__init__.py",
        "fold.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//zisk_zorch/quotient",
        requirement("frx"),
        requirement("zk_dtypes"),
        requirement("pyzorch"),
    ],
)

py_test(
    name = "fold_test",
    size = "medium",
    srcs = ["fold_test.py"],
    data = ["testdata/golden/fri_fold.json"],
    deps = [
        ":fold",
        "//zisk_zorch:golden",
        requirement("absl_py"),
    ],
)

# Adapters binding pil2's FRI to zorch's k-ary fold seam: the KFoldableCode
# (grouping + coset fold) and the pil2 transcript as a zorch Transcript.
py_library(
    name = "seam",
    srcs = ["seam.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":fold",
        "//zisk_zorch/transcript",
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ],
)

py_test(
    name = "seam_test",
    size = "small",
    srcs = ["seam_test.py"],
    data = ["testdata/golden/fri_final.json"],
    deps = [
        ":seam",
        "//zisk_zorch:golden",
        requirement("absl_py"),
        requirement("frx"),
    ],
)

# pil2's FRI query-position derivation: finalPol absorb -> challenge -> grinding
# (self-derived PoW nonce) -> reseed with challenge++nonce -> getPermutations.
py_library(
    name = "queries",
    srcs = ["queries.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":seam",
        "//zisk_zorch/poseidon2:goldilocks",
        "//zisk_zorch/transcript",
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ],
)

py_test(
    name = "queries_test",
    size = "small",
    srcs = ["queries_test.py"],
    data = [
        "testdata/golden/grinding.json",
        "testdata/golden/query_sample.json",
    ],
    deps = [
        ":queries",
        "//zisk_zorch:golden",
        "//zisk_zorch/transcript",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
    ],
)

# The full FRI prover: fold the layer chain, commit each layer, open queries.
py_library(
    name = "prover",
    srcs = ["prover.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":seam",
        "//zisk_zorch:types",
        "//zisk_zorch/commit:openings",
        "//zisk_zorch/commit:trace_commit",
        "//zisk_zorch/transcript",
        requirement("frx"),
        requirement("numpy"),
        requirement("pyzorch"),
    ],
)

py_test(
    name = "prover_test",
    size = "medium",
    srcs = ["prover_test.py"],
    data = ["testdata/golden/fri_prove.json"],
    deps = [
        ":prover",
        "//zisk_zorch:golden",
        "//zisk_zorch/transcript",
        requirement("absl_py"),
    ],
)

# The FRI verifier: replay challenges, verify Merkle openings + fold consistency.
py_library(
    name = "verifier",
    srcs = ["verifier.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":queries",
        ":seam",
        "//zisk_zorch/commit:openings",
        "//zisk_zorch/commit:trace_commit",
        "//zisk_zorch/transcript",
        requirement("frx"),
        requirement("numpy"),
        requirement("pyzorch"),
    ],
)

py_test(
    name = "verifier_test",
    size = "medium",
    srcs = ["verifier_test.py"],
    data = ["testdata/golden/fri_prove.json"],
    deps = [
        ":prover",
        ":queries",
        ":verifier",
        "//zisk_zorch:golden",
        "//zisk_zorch/transcript",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ],
)

# FRI-fold byte-match runnable vs a pil2 fold-kernel dump (--dump=<dir>).
py_binary(
    name = "verify_fri_prove",
    srcs = ["verify_fri_prove.py"],
    deps = [
        ":fold",
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
        requirement("pyzorch"),
    ],
)

# The same byte-gate as a CI test, on the committed [12,9,6,5] capture
# (includes the 1-bit tail fold).
py_test(
    name = "verify_fri_prove_test",
    srcs = ["verify_fri_prove.py"],
    args = ["--dump=zisk_zorch/fri/testdata/dump/fri"],
    data = glob(["testdata/dump/fri/**"]),
    main = "verify_fri_prove.py",
    deps = [
        ":fold",
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
        requirement("pyzorch"),
    ],
)
