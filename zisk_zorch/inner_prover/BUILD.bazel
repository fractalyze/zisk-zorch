load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")
load("@zisk_zorch_pip//:requirements.bzl", "requirement")

# Warm-GPU microbench for the inner-proof stages, on zkbench. Deps the cuda
# plugin so the stages can be timed on the GPU bar, which is the comparison
# against native ZisK this bench exists for. Run:
#   CPU: bazel run //zisk_zorch/inner_prover:bench_inner_proof -- --n_bits=20
#   GPU: FRX_PLATFORMS=cuda CUDA_VISIBLE_DEVICES=0 \
#        bazel run //zisk_zorch/inner_prover:bench_inner_proof -- --n_bits=20 -o report.json
py_binary(
    name = "bench_inner_proof",
    srcs = ["bench_inner_proof.py"],
    deps = [
        "//zisk_zorch/commit:trace_commit",
        "//zisk_zorch/constraints:chip_loader",  # quotient --chip=<air> (#66)
        "//zisk_zorch/fri:prover",
        "//zisk_zorch/poseidon2:goldilocks",
        "//zisk_zorch/quotient",
        "//zisk_zorch/transcript",
        requirement("frx"),
        requirement("frx_cuda12_pjrt"),
        requirement("frx_cuda12_plugin"),
        requirement("numpy"),
        requirement("zk_dtypes"),
        requirement("zkbench"),
        requirement("pyzorch"),
    ],
)

# A real bench run needs a GPU host, so CI can't execute one. This covers what
# would otherwise rot unnoticed: an import error, a BenchmarkOp signature that
# drifts from zkbench, or a --stages list out of sync with _STAGES.
py_test(
    name = "bench_inner_proof_test",
    size = "small",
    srcs = ["bench_inner_proof_test.py"],
    deps = [
        ":bench_inner_proof",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
        # test_chip_mode_folds_a_real_air skips itself unless rw_constraints
        # imports, so without this dep that test never runs under bazel.
        requirement("rw_constraints"),
        requirement("zk_dtypes"),
    ],
)

py_library(
    name = "prover",
    srcs = ["prover.py"],
    visibility = ["//visibility:public"],
    deps = [
        "//zisk_zorch:types",
        "//zisk_zorch/opening:prover",
        "//zisk_zorch/quotient:prover",
        "//zisk_zorch/transcript",
        requirement("frx"),
        requirement("numpy"),
        requirement("pyzorch"),
    ],
)

py_test(
    name = "prover_test",
    size = "medium",
    srcs = ["prover_test.py"],
    deps = [
        ":prover",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ],
)

# The dual VerifierStage roles of the prover's composite: transcript replay,
# Merkle/DEEP/FRI checks, and the AIR constraint check at the OOD point.
py_library(
    name = "verifier",
    srcs = ["verifier.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":prover",
        "//zisk_zorch:types",
        "//zisk_zorch/opening:prover",
        "//zisk_zorch/opening:verifier",
        "//zisk_zorch/quotient:verifier",
        "//zisk_zorch/transcript",
        requirement("frx"),
        requirement("pyzorch"),
    ],
)

py_test(
    name = "verifier_test",
    size = "medium",
    srcs = ["verifier_test.py"],
    deps = [
        ":prover",
        ":verifier",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ],
)

# pil2's value-packing and buffer-layout conventions — one home below the
# harness's loader, replay, and roles, so the packing cannot drift between
# the pil2-mode prover and the byte-gates' reference reads.
py_library(
    name = "pil2",
    srcs = ["pil2.py"],
    deps = [
        "//zisk_zorch/transcript",
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
        requirement("pyzorch"),
    ],
)

# The pil2-mode prover: the byte-match harness's composite and its claim
# types — conformance tooling, never a production role, which is why it
# lives here and not in the stage packages.
py_library(
    name = "pil2_prover",
    srcs = ["pil2_prover.py"],
    deps = [
        ":pil2",
        "//zisk_zorch:golden",
        "//zisk_zorch:types",
        "//zisk_zorch/commit:openings",
        "//zisk_zorch/commit:trace_commit",
        "//zisk_zorch/evals:lev",
        "//zisk_zorch/fri:prover",
        "//zisk_zorch/fri:queries",
        "//zisk_zorch/quotient",
        "//zisk_zorch/transcript",
        requirement("frx"),
        requirement("numpy"),
        requirement("pyzorch"),
        requirement("zk_dtypes"),
    ],
)

# Loader for a PIL2_DUMP_DIR capture bundle: file naming, npy decoding, limb
# layout, and the pil2 packing conventions delegated to :pil2.
py_library(
    name = "capture",
    srcs = ["capture.py"],
    deps = [
        ":pil2",
        ":pil2_prover",
        "//zisk_zorch/quotient",
        requirement("frx"),
        requirement("numpy"),
        requirement("pyzorch"),
        requirement("zk_dtypes"),
    ],
)

# genProof's Fiat-Shamir schedule, replayable against a capture bundle.
py_library(
    name = "schedule",
    srcs = ["schedule.py"],
    deps = [
        ":capture",
        ":pil2",
        "//zisk_zorch/commit:trace_commit",
        "//zisk_zorch/fri:seam",
        "//zisk_zorch/transcript",
        requirement("frx"),
        requirement("numpy"),
        requirement("pyzorch"),
        requirement("zk_dtypes"),
    ],
)

# The per-stage byte-gates: production path on the capture's dumped inputs
# vs its dumped section, one gate per stage in proof order.
py_library(
    name = "gates",
    srcs = ["gates.py"],
    deps = [
        ":capture",
        ":schedule",
        "//zisk_zorch/commit:trace_commit",
        "//zisk_zorch/evals:lev",
        "//zisk_zorch/fri:fold",
        "//zisk_zorch/quotient",
        requirement("frx"),
        requirement("numpy"),
        requirement("pyzorch"),
        requirement("zk_dtypes"),
    ],
)

# Skips loudly without a ZISK_PIL2_CAPTURE bundle: the reference is a
# host-provided native artifact, so CI (no capture) skips and provisioned
# hosts run the gates for real.
py_test(
    name = "gates_test",
    size = "large",
    srcs = ["gates_test.py"],
    env_inherit = ["ZISK_PIL2_CAPTURE"],
    deps = [
        ":capture",
        ":gates",
        requirement("absl_py"),
    ],
)

# Composed byte-match of the pil2-mode prover vs a real pil2-proofman
# genProof dump — a runnable, never a test: it needs a host-provided capture
# (the ZISK_PIL2_CAPTURE bundle; tools/pil2-dump regenerates one), so it
# stays out of CI. --max_stage=N checks a prefix of the schedule.
py_binary(
    name = "verify_inner_proof",
    srcs = ["verify_inner_proof.py"],
    deps = [
        ":capture",
        ":gates",
        ":pil2_prover",
        ":schedule",
        "//zisk_zorch:types",
        "//zisk_zorch/fri:queries",
        "//zisk_zorch/fri:seam",
        "//zisk_zorch/transcript",
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ],
)

# Timing twin of verify_inner_proof: same dump, same stages, warm medians.
py_binary(
    name = "bench_prove_e2e",
    srcs = ["bench_prove_e2e.py"],
    deps = [
        "//zisk_zorch/commit:openings",
        "//zisk_zorch/commit:trace_commit",
        "//zisk_zorch/evals:lev",
        "//zisk_zorch/fri:prover",
        "//zisk_zorch/fri:queries",
        "//zisk_zorch/poseidon2:goldilocks",
        "//zisk_zorch/quotient",
        "//zisk_zorch/transcript",
        requirement("frx"),
        requirement("numpy"),
        requirement("pyzorch"),
        requirement("zk_dtypes"),
    ],
)
