load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")
load("@zisk_zorch_pip//:requirements.bzl", "requirement")

# Stage-2 quotient: the composite constraint polynomial folded by powers of the
# quotient challenge (zorch.constraint_eval) divided by pil2's inverse zerofier.
py_library(
    name = "quotient",
    srcs = [
        "__init__.py",
        "cexp_ref.py",
        "gsum.py",
        "quotient.py",
        "reauthor.py",
        "zerofier.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//zisk_zorch:golden",
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
        requirement("pyzorch"),
    ],
)

py_test(
    name = "quotient_test",
    size = "medium",
    srcs = ["quotient_test.py"],
    data = ["testdata/golden/zerofier_inv.json"],
    deps = [
        ":quotient",
        "//zisk_zorch:golden",
        requirement("absl_py"),
        requirement("pyzorch"),
    ],
)

py_test(
    name = "cexp_ref_test",
    size = "medium",
    srcs = ["cexp_ref_test.py"],
    data = [
        "testdata/arith_cexp.json",
        "testdata/arith_constraints.json",
        "testdata/binary_cexp.json",
        "testdata/binary_constraints.json",
        "testdata/golden/cexp_eval.json",
        "testdata/memalign_readbyte_cexp.json",
        "testdata/memalign_readbyte_constraints.json",
    ],
    deps = [
        ":quotient",
        "//zisk_zorch:golden",
        requirement("absl_py"),
    ],
)

py_test(
    name = "reauthor_test",
    size = "medium",
    srcs = ["reauthor_test.py"],
    data = [
        "testdata/arith_constraints.json",
        "testdata/golden/cexp_eval.json",
    ],
    deps = [
        ":quotient",
        "//zisk_zorch:golden",
        "//zisk_zorch/constraints:chip_loader",
        requirement("absl_py"),
    ],
)

py_test(
    name = "gsum_test",
    size = "medium",
    srcs = ["gsum_test.py"],
    data = [
        "testdata/arith_constraints.json",
        "testdata/golden/cexp_eval.json",
        "testdata/golden/gsum.json",
    ],
    deps = [
        ":quotient",
        "//zisk_zorch:golden",
        "//zisk_zorch/constraints:chip_loader",
        requirement("absl_py"),
    ],
)

# The quotient stage's ProverStage role (and its reduction-proof type).
py_library(
    name = "prover",
    srcs = ["prover.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":quotient",
        "//zisk_zorch:types",
        "//zisk_zorch/commit:trace_commit",
        "//zisk_zorch/transcript",
        requirement("frx"),
        requirement("pyzorch"),
        requirement("zk_dtypes"),
    ],
)

# The quotient stage's VerifierStage dual.
py_library(
    name = "verifier",
    srcs = ["verifier.py"],
    visibility = ["//visibility:public"],
    deps = [
        "//zisk_zorch:types",
        "//zisk_zorch/transcript",
        requirement("frx"),
        requirement("pyzorch"),
        requirement("zk_dtypes"),
    ],
)

# LogUp grand-sum byte-match runnable vs a pil2 inv_fold + Blelloch-scan dump
# (--dump=<dir>).
py_binary(
    name = "verify_gsum",
    srcs = ["verify_gsum.py"],
    deps = [
        ":quotient",
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
        requirement("pyzorch"),
    ],
)

# The same byte-gate as a CI test, on the committed 2^10 capture.
py_test(
    name = "verify_gsum_test",
    srcs = ["verify_gsum.py"],
    args = ["--dump=zisk_zorch/quotient/testdata/dump/gsum"],
    data = glob(["testdata/dump/gsum/**"]),
    main = "verify_gsum.py",
    deps = [
        ":quotient",
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
        requirement("pyzorch"),
    ],
)
