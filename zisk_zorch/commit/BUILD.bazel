load("@rules_python//python:defs.bzl", "py_library", "py_test")
load("@zisk_zorch_pip//:requirements.bzl", "requirement")

# pil2's chained linear hash — the Merkle leaf hasher (NOT a zorch Sponge).
py_library(
    name = "linear_hash",
    srcs = [
        "__init__.py",
        "linear_hash.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        requirement("frx"),
        requirement("hash_frx"),
        requirement("pyzorch"),
    ],
)

# Stage-1 trace commit: coset-7 LDE + linear-hash leaves + k-ary tree, selectable
# Poseidon2 / Poseidon1 hash family.
py_library(
    name = "trace_commit",
    srcs = ["trace_commit.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":linear_hash",
        "//zisk_zorch:types",
        "//zisk_zorch/poseidon1:goldilocks",
        "//zisk_zorch/poseidon2:goldilocks",
        "//zisk_zorch/quotient",
        requirement("frx"),
        requirement("hash_frx"),
        requirement("zk_dtypes"),
        requirement("pyzorch"),
    ],
)

# Query-phase opening: pil2's getGroupProof serialization over the k-ary tree.
py_library(
    name = "openings",
    srcs = ["openings.py"],
    visibility = ["//visibility:public"],
    deps = [
        requirement("frx"),
        requirement("pyzorch"),
    ],
)

py_test(
    name = "linear_hash_test",
    # `test_batched_rows_hash_like_single_rows` compiles a leaf hash per
    # (width, block count, batch size); declared explicitly so a pin bump that
    # invalidates the cache cannot push the cold run past what `medium`
    # derives (see docs/development.md "Test sizing & timeouts").
    size = "medium",
    timeout = "long",
    srcs = ["linear_hash_test.py"],
    data = ["testdata/golden/linear_hash.json"],
    deps = [
        ":linear_hash",
        "//zisk_zorch:golden",
        "//zisk_zorch/poseidon1:goldilocks",
        "//zisk_zorch/poseidon2:goldilocks",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ],
)

py_test(
    name = "fusion_test",
    # The sparse-Poseidon emitter's compile dominates (~1 min for the leaf
    # sponge, ~15 s per level); cold on the CI runner that passes `medium`.
    size = "medium",
    timeout = "long",
    srcs = ["fusion_test.py"],
    # GPU-only: off the card both families route to the generic marker by
    # design (Poseidon1 in hash-frx, Poseidon2 in `poseidon2.goldilocks`).
    tags = ["gpu"],
    deps = [
        ":trace_commit",
        requirement("absl_py"),
        requirement("frx"),
        requirement("pyzorch"),
        requirement("zk_dtypes"),
    ],
)

py_test(
    name = "openings_test",
    # ~135 s warm, but a dependency bump invalidates the cache and the cold run
    # under CI's parallel load lands at ~300 s — right on the cap `medium` would
    # derive. Declared so a pin bump does not turn this into a TIMEOUT.
    size = "medium",
    timeout = "long",
    srcs = ["openings_test.py"],
    data = ["testdata/golden/merkle_proof.json"],
    deps = [
        ":openings",
        ":trace_commit",
        "//zisk_zorch:golden",
        requirement("absl_py"),
        requirement("zk_dtypes"),
    ],
)

py_test(
    name = "trace_commit_test",
    size = "large",
    srcs = ["trace_commit_test.py"],
    data = [
        "testdata/golden/lde.json",
        "testdata/golden/merkle_root.json",
        "testdata/golden/stage1_commit.json",
    ],
    deps = [
        ":trace_commit",
        "//zisk_zorch:golden",
        requirement("absl_py"),
    ],
)

py_test(
    name = "poseidon1_commit_test",
    # The stage-1 goldens compile the fused Poseidon1 sponge and one tree
    # level per height (~75 s + 3 x 16 s each on the GPU; see docs/bridge.md
    # "Compile cost"), plus one sponge per `_DEDICATED_LENGTHS` entry; the
    # remaining leaf-hash lengths take the generic route (see the test's
    # docstring), or this would run ~1000 s. What is left still measures 378 s
    # on a quiet card and 654 s while another job holds it, so it declares a
    # timeout rather than sit under the 900 s `large` derives — a cold CI run
    # under parallel load is the case that rule exists for, and there is no
    # tier between 900 s and `eternal`.
    size = "large",
    timeout = "eternal",
    srcs = ["poseidon1_commit_test.py"],
    data = [
        "testdata/golden/poseidon1_linear_hash.json",
        "testdata/golden/poseidon1_stage1_commit.json",
    ],
    deps = [
        ":linear_hash",
        ":trace_commit",
        "//zisk_zorch:golden",
        "//zisk_zorch/poseidon1:goldilocks",
        requirement("absl_py"),
        requirement("hash_frx"),
    ],
)

py_test(
    name = "fullprogram_commit_test",
    # Commits the 2^21-row trace once per hash family, so it costs about twice
    # what it did with the Poseidon2 fixture alone — past what `medium` derives.
    size = "medium",
    timeout = "long",
    srcs = ["fullprogram_commit_test.py"],
    data = glob(["testdata/fullprogram/**"]),
    deps = [
        ":trace_commit",
        "//zisk_zorch:golden",
        requirement("absl_py"),
        requirement("zk_dtypes"),
    ],
)
