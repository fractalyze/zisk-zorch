load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")
load("@zisk_zorch_pip//:requirements.bzl", "requirement")

# pil2's chained linear hash — the Merkle leaf hasher (NOT a zorch Sponge).
py_library(
    name = "linear_hash",
    srcs = [
        "__init__.py",
        "linear_hash.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        requirement("frx"),
        requirement("pyzorch"),
    ],
)

# Stage-1 trace commit: coset-7 LDE + linear-hash leaves + k-ary Poseidon2 tree.
py_library(
    name = "trace_commit",
    srcs = ["trace_commit.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":linear_hash",
        "//zisk_zorch:types",
        "//zisk_zorch/poseidon2:goldilocks",
        "//zisk_zorch/quotient",
        requirement("frx"),
        requirement("zk_dtypes"),
        requirement("pyzorch"),
    ],
)

# Query-phase opening: pil2's getGroupProof serialization over the k-ary tree.
py_library(
    name = "openings",
    srcs = ["openings.py"],
    visibility = ["//visibility:public"],
    deps = [
        requirement("frx"),
        requirement("pyzorch"),
    ],
)

py_test(
    name = "linear_hash_test",
    size = "medium",
    srcs = ["linear_hash_test.py"],
    data = ["testdata/golden/linear_hash.json"],
    deps = [
        ":linear_hash",
        "//zisk_zorch:golden",
        "//zisk_zorch/poseidon2:goldilocks",
        requirement("absl_py"),
    ],
)

py_test(
    name = "openings_test",
    size = "medium",
    srcs = ["openings_test.py"],
    data = ["testdata/golden/merkle_proof.json"],
    deps = [
        ":openings",
        ":trace_commit",
        "//zisk_zorch:golden",
        requirement("absl_py"),
        requirement("zk_dtypes"),
    ],
)

# Stage-1 byte-match runnable: commit_trace vs a real pil2-proofman dump.
py_binary(
    name = "verify_trace_commit",
    srcs = ["verify_trace_commit.py"],
    data = glob([
        "testdata/dump/stage1/commit.json",
        "testdata/dump/stage1/trace.bin",
    ]),
    deps = [
        ":trace_commit",
        "//zisk_zorch:dump",
        requirement("absl_py"),
    ],
)

py_test(
    name = "trace_commit_test",
    size = "large",
    srcs = ["trace_commit_test.py"],
    data = [
        "testdata/golden/lde.json",
        "testdata/golden/merkle_root.json",
        "testdata/golden/stage1_commit.json",
    ],
    deps = [
        ":trace_commit",
        "//zisk_zorch:golden",
        requirement("absl_py"),
    ],
)

py_test(
    name = "fullprogram_commit_test",
    size = "medium",
    srcs = ["fullprogram_commit_test.py"],
    data = glob(["testdata/fullprogram/**"]),
    deps = [
        ":trace_commit",
        "//zisk_zorch:golden",
        requirement("absl_py"),
        requirement("zk_dtypes"),
    ],
)

# The stage-1 byte-gate as a CI test: no --dump, so it runs on the committed
# n_bits=8 fixture (the flag's default).
py_test(
    name = "verify_trace_commit_test",
    srcs = ["verify_trace_commit.py"],
    data = glob([
        "testdata/dump/stage1/commit.json",
        "testdata/dump/stage1/trace.bin",
    ]),
    main = "verify_trace_commit.py",
    deps = [
        ":trace_commit",
        "//zisk_zorch:dump",
        requirement("absl_py"),
    ],
)
