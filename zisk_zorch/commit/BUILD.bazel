load("@rules_python//python:defs.bzl", "py_library", "py_test")
load("@zisk_zorch_pip//:requirements.bzl", "requirement")

# pil2's chained linear hash — the Merkle leaf hasher (NOT a zorch Sponge).
py_library(
    name = "linear_hash",
    srcs = [
        "__init__.py",
        "linear_hash.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        requirement("frx"),
        requirement("hash_frx"),
        requirement("pyzorch"),
    ],
)

# Stage-1 trace commit: coset-7 LDE + linear-hash leaves + k-ary tree, selectable
# Poseidon2 / Poseidon1 hash family.
py_library(
    name = "trace_commit",
    srcs = ["trace_commit.py"],
    visibility = ["//visibility:public"],
    deps = [
        requirement("hash-frx"),
        ":linear_hash",
        "//zisk_zorch:types",
        "//zisk_zorch/poseidon1:goldilocks",
        "//zisk_zorch/poseidon2:goldilocks",
        "//zisk_zorch/quotient",
        requirement("frx"),
        requirement("hash_frx"),
        requirement("zk_dtypes"),
        requirement("pyzorch"),
    ],
)

# Query-phase opening: pil2's getGroupProof serialization over the k-ary tree.
py_library(
    name = "openings",
    srcs = ["openings.py"],
    visibility = ["//visibility:public"],
    deps = [
        requirement("frx"),
        requirement("pyzorch"),
    ],
)

py_test(
    name = "linear_hash_test",
    size = "medium",
    srcs = ["linear_hash_test.py"],
    data = ["testdata/golden/linear_hash.json"],
    deps = [
        ":linear_hash",
        "//zisk_zorch:golden",
        "//zisk_zorch/poseidon2:goldilocks",
        requirement("absl_py"),
    ],
)

py_test(
    name = "openings_test",
    # ~135 s warm, but a dependency bump invalidates the cache and the cold run
    # under CI's parallel load lands at ~300 s — right on the cap `medium` would
    # derive. Declared so a pin bump does not turn this into a TIMEOUT.
    size = "medium",
    timeout = "long",
    srcs = ["openings_test.py"],
    data = ["testdata/golden/merkle_proof.json"],
    deps = [
        ":openings",
        ":trace_commit",
        "//zisk_zorch:golden",
        requirement("absl_py"),
        requirement("zk_dtypes"),
    ],
)

py_test(
    name = "trace_commit_test",
    size = "large",
    srcs = ["trace_commit_test.py"],
    data = [
        "testdata/golden/lde.json",
        "testdata/golden/merkle_root.json",
        "testdata/golden/stage1_commit.json",
    ],
    deps = [
        ":trace_commit",
        "//zisk_zorch:golden",
        requirement("absl_py"),
    ],
)

py_test(
    name = "poseidon1_commit_test",
    size = "large",
    srcs = ["poseidon1_commit_test.py"],
    data = [
        "testdata/golden/poseidon1_linear_hash.json",
        "testdata/golden/poseidon1_stage1_commit.json",
    ],
    deps = [
        ":linear_hash",
        ":trace_commit",
        "//zisk_zorch:golden",
        "//zisk_zorch/poseidon1:goldilocks",
        requirement("absl_py"),
    ],
)

py_test(
    name = "fullprogram_commit_test",
    # Commits the 2^21-row trace once per hash family, so it costs about twice
    # what it did with the Poseidon2 fixture alone — past what `medium` derives.
    size = "medium",
    timeout = "long",
    srcs = ["fullprogram_commit_test.py"],
    data = glob(["testdata/fullprogram/**"]),
    deps = [
        ":trace_commit",
        "//zisk_zorch:golden",
        requirement("absl_py"),
        requirement("zk_dtypes"),
    ],
)
