load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")
load("@zisk_zorch_pip//:requirements.bzl", "requirement")

# Loaders for the golden/ JSON fixtures every byte-match test consumes.
py_library(
    name = "golden",
    srcs = [
        "__init__.py",
        "golden.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ],
)

# Warm-GPU microbench for the inner-proof stages, on zkbench. Deps the cuda
# plugin so the stages can be timed on the GPU bar, which is the comparison
# against native ZisK this bench exists for. Run:
#   CPU: bazel run //zisk_zorch:bench_inner_proof -- --n_bits=20
#   GPU: FRX_PLATFORMS=cuda CUDA_VISIBLE_DEVICES=0 \
#        bazel run //zisk_zorch:bench_inner_proof -- --n_bits=20 -o report.json
py_binary(
    name = "bench_inner_proof",
    srcs = ["bench_inner_proof.py"],
    deps = [
        "//zisk_zorch/commit:trace_commit",
        "//zisk_zorch/constraints:chip_loader",  # quotient --chip=<air> (#66)
        "//zisk_zorch/fri:prover",
        "//zisk_zorch/poseidon2:goldilocks",
        "//zisk_zorch/quotient",
        "//zisk_zorch/transcript",
        requirement("frx"),
        requirement("frx_cuda12_pjrt"),
        requirement("frx_cuda12_plugin"),
        requirement("numpy"),
        requirement("zk_dtypes"),
        requirement("zkbench"),
        requirement("pyzorch"),
    ],
)

# A real bench run needs a GPU host, so CI can't execute one. This covers what
# would otherwise rot unnoticed: an import error, a BenchmarkOp signature that
# drifts from zkbench, or a --stages list out of sync with _STAGES.
py_test(
    name = "bench_inner_proof_test",
    size = "small",
    srcs = ["bench_inner_proof_test.py"],
    deps = [
        ":bench_inner_proof",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
        # test_chip_mode_folds_a_real_air skips itself unless rw_constraints
        # imports, so without this dep that test never runs under bazel.
        requirement("rw_constraints"),
        requirement("zk_dtypes"),
    ],
)

# End-to-end inner proof: one Transcript threading commit -> quotient -> FRI ->
# queries. The DEEP FRI-polynomial stage is an injected seam (no byte-match
# primitive exists), so this wires the spine, not a pil2-conformant proof.
# The inner proof's shared data types (statement, witnesses, claims, commit
# handoffs); below every stage so a stage's roles never import the composite
# that runs them.
py_library(
    name = "types",
    srcs = ["types.py"],
    visibility = ["//visibility:public"],
    deps = [requirement("frx")],
)

py_library(
    name = "prover",
    srcs = ["prover.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":types",
        "//zisk_zorch/opening:prover",
        "//zisk_zorch/quotient:prover",
        "//zisk_zorch/transcript",
        requirement("frx"),
        requirement("numpy"),
        requirement("pyzorch"),
    ],
)

py_test(
    name = "prover_test",
    size = "medium",
    srcs = ["prover_test.py"],
    deps = [
        ":prover",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ],
)

# The dual VerifierStage roles of the prover's composite: transcript replay,
# Merkle/DEEP/FRI checks, and the AIR constraint check at the OOD point.
py_library(
    name = "verifier",
    srcs = ["verifier.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":prover",
        ":types",
        "//zisk_zorch/opening:prover",
        "//zisk_zorch/opening:verifier",
        "//zisk_zorch/quotient:verifier",
        "//zisk_zorch/transcript",
        requirement("frx"),
        requirement("pyzorch"),
    ],
)

py_test(
    name = "verifier_test",
    size = "medium",
    srcs = ["verifier_test.py"],
    deps = [
        ":prover",
        ":verifier",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ],
)

# Shared plumbing for the per-stage `verify_*` byte-match runnables: the
# check_match reporter and the pil2 reference-dump loaders.
py_library(
    name = "dump",
    srcs = [
        "__init__.py",
        "dump.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ],
)

# Composed 16-gate byte-match of the full inner proof vs a real pil2-proofman
# genProof dump (--dump/--instance/--starkinfo; the dump is captured by the
# PIL2_DUMP_DIR patch, not committed — a runnable, never a test).
py_binary(
    name = "verify_inner_proof",
    srcs = ["verify_inner_proof.py"],
    deps = [
        "//zisk_zorch/commit:trace_commit",
        "//zisk_zorch/evals:lev",
        "//zisk_zorch/fri:fold",
        "//zisk_zorch/quotient",
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
        requirement("pyzorch"),
    ],
)
