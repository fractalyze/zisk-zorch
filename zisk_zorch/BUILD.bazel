load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")
load("@zisk_zorch_pip//:requirements.bzl", "requirement")

# Loaders for the golden/ JSON fixtures every byte-match test consumes.
py_library(
    name = "golden",
    srcs = [
        "__init__.py",
        "golden.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ],
)

# The inner proof's shared data types (statement, witnesses, claims, commit
# handoffs); below every stage so a stage's roles never import the composite
# that runs them (the composite lives in inner_prover/).
py_library(
    name = "types",
    srcs = ["types.py"],
    visibility = ["//visibility:public"],
    deps = [requirement("frx")],
)

# pil2's value-packing and buffer-layout conventions — one home below the
# pil2-mode roles and the capture loader, so the packing cannot drift between
# the prover and the byte-gates' reference reads.
py_library(
    name = "pil2",
    srcs = ["pil2.py"],
    visibility = ["//visibility:public"],
    deps = [
        "//zisk_zorch/transcript",
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
        requirement("pyzorch"),
    ],
)
