load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")
load("@zisk_zorch_pip//:requirements.bzl", "requirement")

# The pil2 schedule as per-AIR device programs, built over the pil2-mode
# roles so each program is the role's own traced function.
py_library(
    name = "stages",
    srcs = [
        "__init__.py",
        "stages.py",
    ],
    deps = [
        "//zisk_zorch/commit:openings",
        "//zisk_zorch/commit:trace_commit",
        "//zisk_zorch/evals:lev",
        "//zisk_zorch/fri:queries",
        "//zisk_zorch/fri:seam",
        "//zisk_zorch/harness:pil2",
        "//zisk_zorch/harness:pil2_prover",
        "//zisk_zorch/quotient",
        "//zisk_zorch/transcript",
        requirement("frx"),
        requirement("numpy"),
        requirement("pyzorch"),
        requirement("zk_dtypes"),
    ],
)

# The exporter: one artifact directory per (AIR, nBits) — StableHLO bytecode
# per program plus the manifest the C bridge binds buffers by.
#   FRX_PLATFORMS=cuda bazel run //zisk_zorch/export:export_air -- \
#       --proving_key=<provingKey> --air=Main --out=$PWD/artifacts
py_binary(
    name = "export_air",
    srcs = ["export_air.py"],
    deps = [
        ":stages",
        "//zisk_zorch/harness:pil2",
        "//zisk_zorch/harness:pil2_prover",
        "//zisk_zorch/harness:recursion",
        "//zisk_zorch/harness:zisk_key",
        requirement("frx"),
        requirement("frx_cuda12_pjrt"),
        requirement("frx_cuda12_plugin"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ],
)

# The artifacts at runtime: manifest-driven compile + execute through the
# low-level PJRT client, so the Python replay exercises the bytes the C
# bridge loads rather than a re-traced program.
py_library(
    name = "runtime",
    srcs = ["runtime.py"],
    deps = [
        requirement("frx"),
        requirement("numpy"),
        requirement("pyzorch"),
        requirement("zk_dtypes"),
    ],
)

# genProof's host half over the artifacts — the C driver's Python twin and
# the schedule the bridge mirrors.
py_library(
    name = "replay",
    srcs = ["replay.py"],
    deps = [
        ":runtime",
        "//zisk_zorch/fri:queries",
        "//zisk_zorch/harness:pil2",
        "//zisk_zorch/harness:proof_serializer",
        "//zisk_zorch/transcript",
        requirement("numpy"),
    ],
)

# Random instances for the byte-gates, and the case dumper the Rust bridge's
# zz_prove reads (python -m zisk_zorch.export.cases).
py_library(
    name = "cases",
    srcs = ["cases.py"],
    deps = [
        ":export_air",
        ":replay",
        ":runtime",
        "//zisk_zorch/harness:pil2",
        requirement("numpy"),
        requirement("zk_dtypes"),
    ],
)

py_binary(
    name = "dump_case",
    srcs = ["cases.py"],
    main = "cases.py",
    deps = [
        ":cases",
        requirement("frx_cuda12_pjrt"),
        requirement("frx_cuda12_plugin"),
    ],
)

# Needs a proving key (ZISK_PROVING_KEY) and a GPU — skips itself otherwise,
# like the harness's key-fed tests. ZISK_ARTIFACTS reuses an export.
py_test(
    name = "stages_test",
    size = "large",
    timeout = "eternal",
    srcs = ["stages_test.py"],
    env_inherit = [
        "ZISK_ARTIFACTS",
        "ZISK_EXPORT_AIR",
        "ZISK_PROVING_KEY",
    ],
    deps = [
        ":cases",
        ":export_air",
        ":replay",
        ":runtime",
        ":stages",
        "//zisk_zorch:types",
        "//zisk_zorch/commit:trace_commit",
        "//zisk_zorch/harness:block_composite",
        "//zisk_zorch/harness:pil2",
        "//zisk_zorch/harness:pil2_prover",
        "//zisk_zorch/transcript",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ],
)
