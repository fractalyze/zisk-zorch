load("@rules_python//python:defs.bzl", "py_library", "py_test")
load("@zisk_zorch_pip//:requirements.bzl", "requirement")

# pil2-stark's concrete Poseidon1-Goldilocks instances (the native default hash
# family) over zorch's optimized-sparse engine. `goldilocks_constants.json` is a
# fixture-gen dump of pil2's own Poseidon1 constants, loaded at import.
py_library(
    name = "goldilocks",
    srcs = [
        "__init__.py",
        "goldilocks.py",
    ],
    data = ["goldilocks_constants.json"],
    visibility = ["//visibility:public"],
    deps = [
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
        requirement("pyzorch"),
    ],
)

py_test(
    name = "goldilocks_test",
    size = "medium",
    srcs = ["goldilocks_test.py"],
    data = glob(["testdata/golden/**"]),
    deps = [
        ":goldilocks",
        "//zisk_zorch:golden",
        requirement("absl_py"),
    ],
)

py_library(
    name = "goldilocks_host",
    srcs = ["goldilocks_host.py"],
    data = ["goldilocks_constants.json"],
    visibility = ["//visibility:public"],
    deps = [requirement("numpy")],
)

py_test(
    name = "goldilocks_host_test",
    size = "medium",
    srcs = ["goldilocks_host_test.py"],
    data = glob(["testdata/golden/**"]),
    deps = [
        ":goldilocks_host",
        requirement("absl_py"),
    ],
)
