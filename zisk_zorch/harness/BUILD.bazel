load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")
load("@zisk_zorch_pip//:requirements.bzl", "requirement")

# pil2's value-packing and buffer-layout conventions — one home below the
# harness's loader, replay, and roles, so the packing cannot drift between
# the pil2-mode prover and the byte-gates' reference reads.
py_library(
    name = "pil2",
    srcs = [
        "__init__.py",
        "pil2.py",
    ],
    deps = [
        "//zisk_zorch/transcript",
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
        requirement("pyzorch"),
    ],
)

# pil2's flat-proof writer — proof2pointer in numpy, plus the per-tree
# wire-shaped query openings the prover's emit_wire path assembles.
py_library(
    name = "proof_serializer",
    srcs = ["proof_serializer.py"],
    deps = [
        ":pil2",
        "//zisk_zorch/commit:openings",
        "//zisk_zorch/transcript",
        requirement("frx"),
        requirement("numpy"),
    ],
)

# The pil2-mode prover: the byte-match harness's composite and its claim
# types — conformance tooling, never a production role, which is why it
# lives here and not in the stage packages.
py_library(
    name = "pil2_prover",
    visibility = ["//zisk_zorch:__pkg__"],
    srcs = ["pil2_prover.py"],
    deps = [
        ":proof_serializer",
        "//zisk_zorch/logup",
        ":pil2",
        "//zisk_zorch:golden",
        "//zisk_zorch:types",
        "//zisk_zorch/commit:openings",
        "//zisk_zorch/commit:trace_commit",
        "//zisk_zorch/evals:lev",
        "//zisk_zorch/fri:prover",
        "//zisk_zorch/fri:queries",
        "//zisk_zorch/quotient",
        "//zisk_zorch/transcript",
        requirement("frx"),
        requirement("numpy"),
        requirement("pyzorch"),
        requirement("zk_dtypes"),
    ],
)

# Loader for a PIL2_DUMP_DIR capture bundle: file naming, npy decoding, limb
# layout, and the pil2 packing conventions delegated to :pil2.
py_library(
    name = "capture",
    visibility = ["//zisk_zorch:__pkg__"],
    srcs = ["capture.py"],
    deps = [
        ":pil2",
        ":pil2_prover",
        "//zisk_zorch/quotient",
        requirement("frx"),
        requirement("numpy"),
        requirement("pyzorch"),
        requirement("zk_dtypes"),
    ],
)

# genProof's Fiat-Shamir schedule, replayable against a capture bundle.
py_library(
    name = "schedule",
    visibility = ["//zisk_zorch:__pkg__"],
    srcs = ["schedule.py"],
    deps = [
        ":capture",
        ":pil2",
        "//zisk_zorch/commit:trace_commit",
        "//zisk_zorch/fri:seam",
        "//zisk_zorch/transcript",
        requirement("frx"),
        requirement("numpy"),
        requirement("pyzorch"),
        requirement("zk_dtypes"),
    ],
)

# The per-stage byte-gates: production path on the capture's dumped inputs
# vs its dumped section, one gate per stage in proof order.
py_library(
    name = "gates",
    visibility = ["//zisk_zorch:__pkg__"],
    srcs = ["gates.py"],
    deps = [
        "//zisk_zorch/logup",
        ":capture",
        ":schedule",
        "//zisk_zorch/commit:trace_commit",
        "//zisk_zorch/evals:lev",
        "//zisk_zorch/fri:fold",
        "//zisk_zorch/quotient",
        requirement("frx"),
        requirement("numpy"),
        requirement("pyzorch"),
        requirement("zk_dtypes"),
    ],
)

# Skips loudly without a ZISK_PIL2_CAPTURE bundle: the reference is a
# host-provided native artifact, so CI (no capture) skips and provisioned
# hosts run the gates for real.
py_test(
    name = "capture_test",
    srcs = ["capture_test.py"],
    deps = [
        ":capture",
        requirement("absl_py"),
    ],
)

# The recursion zkin builder: every witness input of the aggregation
# tower from the composite's own artifacts (byte-pinned against the
# native tower's 66 zkins on block 21740136).
py_library(
    name = "zkin",
    srcs = ["zkin.py"],
    visibility = ["//zisk_zorch:__pkg__"],
    deps = [
        ":block_composite",
        requirement("numpy"),
    ],
)

# ZisK's proof.bin envelope: the bincode varint stream around the flat
# vadcop-final proof, key-constant trailer carried opaquely.
py_library(
    name = "proof_bin",
    srcs = ["proof_bin.py"],
    visibility = ["//zisk_zorch:__pkg__"],
    deps = [requirement("numpy")],
)

py_test(
    name = "proof_bin_test",
    srcs = ["proof_bin_test.py"],
    deps = [
        ":proof_bin",
        requirement("absl_py"),
    ],
)

# The block composite: every instance proved in one process from the
# self-derived seed, with per-instance wire-proof emission. Bundles the
# contributions phase and the global-constraints binding it orchestrates.
py_library(
    name = "block_composite",
    srcs = [
        "block_composite.py",
        "contributions.py",
        "global_constraints.py",
    ],
    deps = [
        ":capture",
        ":pil2",
        ":pil2_prover",
        ":proof_serializer",
        "//zisk_zorch:types",
        "//zisk_zorch/quotient",
        "//zisk_zorch/transcript",
        requirement("frx"),
        requirement("numpy"),
        requirement("pyzorch"),
    ],
)

py_test(
    name = "wire_proof_test",
    size = "large",
    srcs = ["wire_proof_test.py"],
    env_inherit = ["ZISK_PIL2_CAPTURE"],
    deps = [
        ":block_composite",
        ":capture",
        ":pil2_prover",
        requirement("absl_py"),
    ],
)

py_test(
    name = "gates_test",
    size = "large",
    srcs = ["gates_test.py"],
    env_inherit = ["ZISK_PIL2_CAPTURE"],
    deps = [
        ":capture",
        ":gates",
        requirement("absl_py"),
    ],
)

# prove_block's phase wiring — the composite's only direct exercise.
py_test(
    name = "block_composite_test",
    # A measured bundle run is ~29 min (one Main-scale instance through all
    # four phases, on a shared card) — past even the "large" 900s the other
    # capture-gated suites use.
    size = "enormous",
    srcs = ["block_composite_test.py"],
    deps = [
        ":block_composite",
        ":capture",
        ":verify_proof_layout",
        requirement("absl_py"),
        requirement("numpy"),
    ],
)

# The recursion circuits' proving-key layout and circom witness ABI — the
# aggregation tower's key/calculator half, consumed by the zkin builder and
# the layout checker.
py_library(
    name = "recursion",
    visibility = ["//zisk_zorch:__pkg__"],
    srcs = ["recursion.py"],
    deps = [
        ":pil2",
        "//zisk_zorch/commit:trace_commit",
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ],
)

# Layout/serializer conformance tools. They are runnables rather than tests
# because each needs a capture bundle and a proving key on disk; the targets
# exist so an import break is caught by the build.
py_binary(
    name = "verify_proof_layout",
    srcs = ["verify_proof_layout.py"],
    deps = [
        ":pil2",
        ":proof_serializer",
        ":recursion",
        "//zisk_zorch/transcript",
        requirement("numpy"),
    ],
)

py_binary(
    name = "verify_proof_serializer",
    srcs = ["verify_proof_serializer.py"],
    deps = [
        ":capture",
        ":pil2",
        ":proof_serializer",
        "//zisk_zorch/commit:trace_commit",
        "//zisk_zorch/fri:queries",
        "//zisk_zorch/fri:seam",
        requirement("frx"),
        requirement("numpy"),
        requirement("pyzorch"),
        requirement("zk_dtypes"),
    ],
)

py_binary(
    name = "verify_inner_proof",
    srcs = ["verify_inner_proof.py"],
    deps = [
        ":capture",
        ":gates",
        ":pil2",
        ":pil2_prover",
        ":schedule",
        "//zisk_zorch:types",
        "//zisk_zorch/fri:queries",
        "//zisk_zorch/fri:seam",
        "//zisk_zorch/transcript",
        requirement("frx"),
        requirement("numpy"),
    ],
)
