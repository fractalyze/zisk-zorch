# zisk-zorch runtime dependencies.
#
# Pulled from the Fractalyze package index alongside upstream PyPI:
#   pip install -r requirements.in \
#     --extra-index-url https://fractalyze.github.io/pypi/simple/
absl-py
numpy
# pyzorch is zorch's PyPI distribution name (the import package stays `zorch`).
# Direct wheel URL: the index rebuild has no /simple/pyzorch/ page yet; the
# release asset remains.
pyzorch @ https://github.com/fractalyze/pypi/releases/download/zorch-dev-20260812101713/pyzorch-0.1.0.dev20260812101713-py3-none-any.whl
frx==0.10.2.dev20260910150749
# frx's declared floor (`zk_dtypes>=0.0.15`) under-states what it uses: the
# pinned wheel's `frx/_src/dtypes.py` still reads
# `zk_dtypes.ed25519_g1_affine`, which lands in 0.0.17, so resolving on the
# floor alone imports and then AttributeErrors. Re-check this against the wheel
# each bump, and raise it with the frx quad rather than by the floor.
zk-dtypes==0.0.17
frxlib==0.10.2.dev20260910150749
frx-cuda12-plugin==0.10.2.dev20260910150749
frx-cuda12-pjrt==0.10.2.dev20260910150749
# hash-frx and the frx wheels are one pin: the marker names hash-frx emits
# (`hash_frx.perm.*`, `hash_frx.digest.*`) have to be the spellings the frx
# plugin's ZorchFusedRegionRewriter recognizes, and an unrecognized marker
# inlines silently — right bytes, and every Merkle level as hundreds of loop
# fusions instead of one kernel (#168). Take the hash-frx wheel built from the
# commit that pinned this frx version; `//zisk_zorch/commit:fusion_test` fails
# on the GPU leg when the pair drifts.
hash-frx==0.2.0.dev20260821002042

rw-constraints @ https://github.com/fractalyze/pypi/releases/download/riscv-witness-dev-20260809224945/rw_constraints-0.1.0.dev20260809224945-py3-none-any.whl

# zkbench — the JaxBenchmark harness behind zisk_zorch/bench_inner_proof.py
# (warm-GPU inner-proof microbench, zisk-zorch#30). Direct wheel URL: the pypi
# index rebuild dropped zkbench's /simple/ page; the release asset remains.
zkbench @ https://github.com/fractalyze/pypi/releases/download/zkbench-py-v0.5.0/zkbench-0.5.0-py3-none-any.whl
