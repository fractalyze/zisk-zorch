load("@rules_python//python:defs.bzl", "py_library", "py_test")
load("@zisk_zorch_pip//:requirements.bzl", "requirement")

# Bench tooling for the bridge: the guest input writer, the native <-> bridge
# dump comparison, three readers of a run log (the per-run summarizer, the
# leg's phase structure behind "The gap is the basic phase's wall", and the
# memory story behind "Memory budget"), and the four capture readers behind
# that page's "Profiling" — two per-program (ours and pil2's), one for where
# the uploads sit and one for where the leg's device idle goes. Rules with more
# than one reader live in a module of their own so they cannot drift:
# :nsys_trace owns the span algebra and which prover a kernel belongs to,
# :run_log owns the bridge's per-instance line and whether a run finished.
# run.sh drives one prove; see the page's "Running". :pagecache is the odd one
# out -- it reads the host rather than a run, because proofman's init reads
# gigabytes of the proving key before it sizes anything and pays disk for what
# the page cache does not hold, so run.sh warms that set before every run.

py_library(
    name = "nsys_trace",
    srcs = ["nsys_trace.py"],
)

py_test(
    name = "nsys_trace_test",
    size = "small",
    srcs = ["nsys_trace_test.py"],
    deps = [
        ":nsys_trace",
        requirement("absl_py"),
    ],
)

