load("@rules_python//python:defs.bzl", "py_library", "py_test")
load("@zisk_zorch_pip//:requirements.bzl", "requirement")

# Bench tooling for the bridge: the guest input writer, the native <-> bridge
# dump comparison, the log summarizer behind the numbers in docs/bridge.md,
# and the four capture readers behind that page's "Profiling" — two
# per-program (ours and pil2's), one for where the uploads sit and one for
# where the leg's device idle goes. The two that read a `cuda_gpu_trace`
# share :nsys_trace, which owns the rule telling the provers' kernels apart.
# run.sh drives one prove; see the page's "Running".

py_library(
    name = "nsys_trace",
    srcs = ["nsys_trace.py"],
)

py_test(
    name = "nsys_trace_test",
    size = "small",
    srcs = ["nsys_trace_test.py"],
    deps = [
        ":nsys_trace",
        requirement("absl_py"),
    ],
)

py_library(
    name = "summarize",
    srcs = ["summarize.py"],
)

py_test(
    name = "summarize_test",
    size = "small",
    srcs = ["summarize_test.py"],
    deps = [
        ":summarize",
        requirement("absl_py"),
    ],
)

